# ==============================================================================
# HSCBuddy Environment Variables (.env.example)
# Copy this file to .env.local and fill in your credentials.
# Never expose GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_!
# ==============================================================================

# 1. Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Configuration (Optional for Guest/Demo Mode, required for Cloud Auth/DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. YouTube Data API v3 (Optional - falls back to verified YouTube search links)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

